
#include <iostream>
#include <list>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    
    list<int> l;

    l.push_back(35);
    l.push_back(15);
    l.push_front(10);
    l.push_back(25);

    cout << "LIST CONTAINER" << endl;

    cout << "Initial List: ";
    for (int x : l)
        cout << x << " ";

    
    auto it = l.begin();
    advance(it, 2);
    l.insert(it, 15);

    cout << "\nAfter Insertion: ";
    for (int x : l)
        cout << x << " ";

    
    l.pop_front();

    cout << "\nAfter Deletion: ";
    for (int x : l)
        cout << x << " ";

    
    l.sort();

    cout << "\nSorted List: ";
    for (int x : l)
        cout << x << " ";

    cout << "\nList Size: " << l.size() << endl;


   
    vector<int> v;

    v.push_back(35);
    v.push_back(15);
    v.push_back(25);
    v.push_back(45);

    cout << "\nVECTOR CONTAINER" << endl;

    cout << "Initial Vector: ";
    for (int x : v)
        cout << x << " ";

    
    v.insert(v.begin() + 1, 15);

    cout << "\nAfter Insertion: ";
    for (int x : v)
        cout << x << " ";

    
    v.erase(v.begin() + 2);

    cout << "\nAfter Deletion: ";
    for (int x : v)
        cout << x << " ";

    
    sort(v.begin(), v.end());

    cout << "\nSorted Vector: ";
    for (int x : v)
        cout << x << " ";

    cout << "\nVector Size: " << v.size() << endl;

    return 0;
}
